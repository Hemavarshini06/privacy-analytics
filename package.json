{
  "name": "privacy-analytics",
  "version": "1.0.0",
  "description": "Privacy-Preserving Journey Analytics Tool for Multi-Tenant SaaS Products",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "seed": "node backend/src/db/database.js",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"node --watch backend/server.js\" \"npm run dev --prefix frontend\"",
    "test": "node --test backend/test/**/*.test.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
